# Server
NODE_ENV=development
API_PORT=4000
WS_PORT=4001

# RTMP
RTMP_PORT=1935
RTMP_HOST=localhost

# Stream Platforms (never commit real keys)
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here
FACEBOOK_STREAM_KEY=your_facebook_stream_key_here

# Security
JWT_SECRET=change_this_to_a_random_256_bit_secret
STREAM_KEY_ENCRYPTION_SECRET=change_this_to_a_random_256_bit_secret

# Database
DATABASE_URL=file:./vollycast.db

# Recording
RECORDINGS_PATH=./recordings
MAX_DISK_USAGE_GB=50

# Ports
OVERLAY_PORT=3001
DASHBOARD_PORT=3000
