# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9.1.0

COPY package.json pnpm-workspace.yaml ./
COPY packages/mobile-controller/ ./packages/mobile-controller/

RUN pnpm install --no-frozen-lockfile --ignore-scripts

RUN pnpm --filter @vollycast/mobile-controller build

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

COPY --from=builder /app/packages/mobile-controller/dist /usr/share/nginx/html
COPY infrastructure/nginx/mobile.conf /etc/nginx/conf.d/default.conf

EXPOSE 3002

CMD ["nginx", "-g", "daemon off;"]
