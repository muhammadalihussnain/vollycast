# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9.1.0

COPY package.json pnpm-workspace.yaml ./
COPY packages/web-dashboard/ ./packages/web-dashboard/

RUN pnpm install --no-frozen-lockfile --ignore-scripts

RUN pnpm --filter @vollycast/web-dashboard build

# ── Runtime stage (nginx serves the built SPA) ────────────────────────────────
FROM nginx:alpine AS runtime

COPY --from=builder /app/packages/web-dashboard/dist /usr/share/nginx/html

# nginx config — serve SPA and proxy API calls to vollycast-api
COPY infrastructure/nginx/dashboard.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
